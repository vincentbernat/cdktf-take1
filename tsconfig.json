{
  "compilerOptions": {
    "declaration": true,
    "experimentalDecorators": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "lib": [
      "es2018"
    ],
    "module": "CommonJS",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "strict": true,
    "stripInternal": true,
    "target": "ES2018",
    "incremental": true,
    "types": ["node", "jest"]
  },
  "include": [
    "**/*.ts",
    ".gen/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "cdktf.out"
  ]
}
